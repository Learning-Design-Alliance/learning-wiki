# Copy to /etc/eval-harness.env on the droplet (provision.sh does this for you
# on first run), chmod 600, and fill in real values. Never commit this file
# with real keys — the version in the repo must stay a template.

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sent in the User-Agent for every arXiv/ERIC/PMC fetch — see eval/SOURCES.md.
# Not optional for a real batch: NCBI's usage guidelines ask for a contact so
# they can reach you before blocking your IP, and this is that contact.
EVAL_HARNESS_CONTACT_EMAIL=

# Used by kagglehub to auto-download the Kaggle arXiv metadata snapshot
# (discover_articles.resolve_arxiv_snapshot()) the first time a scrape batch
# requests arxiv > 0 — export.arxiv.org's live search API is blocked outright
# (see eval/SOURCES.md), so this is the only real source for arXiv candidates.
# Downloaded once and cached on disk afterward (kagglehub's own cache) — not
# needed again after that first run. From kaggle.com -> account -> Settings
# -> API -> Create New Token; you only need the two field values, not the
# downloaded kaggle.json file itself.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Which models/articles/judges to run is NOT a secret — it lives in
# deploy/run-config.env (tracked in git) instead of here, so trying a new
# model is a normal code change (edit, commit, `git pull`, restart) rather
# than something that requires opening this secrets file.
