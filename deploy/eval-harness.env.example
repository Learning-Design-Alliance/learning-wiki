# Copy to /etc/eval-harness.env on the droplet (provision.sh does this for you
# on first run), chmod 600, and fill in real values. Never commit this file
# with real keys — the version in the repo must stay a template.

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Arguments passed straight to `scripts/eval_harness.py run` by deploy/run.sh.
# Edit this line to change models/articles/judges without touching the
# systemd unit — then `systemctl restart eval-harness` to pick it up. It's
# split on whitespace, so it can't contain an argument with a space in it
# (none of the flags here need one).
RUN_ARGS=--models qwen/qwen3-30b-a3b google/gemma-3-27b-it qwen/qwen3-235b-a22b --judges opus gpt --run-id do-batch-1
