{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__add_issue_comment|mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/check_embargo.py --claude-hook",
            "timeout": 30,
            "statusMessage": "Checking for embargoed research"
          }
        ]
      }
    ]
  }
}
